{
  "name": "@diklein/dkbezeler",
  "version": "0.1.0",
  "description": "Bake screenshots and screen recordings into device bezel frames at build time. Auto-detects the device from the capture's resolution, measures any frame PNG's screen cutout automatically, and fetches Apple's product bezels onto your machine with one command. Stills are pure sharp; videos need ffmpeg.",
  "license": "MIT",
  "author": "David Klein (https://diklein.com)",
  "homepage": "https://github.com/diklein/dkbezeler",
  "type": "module",
  "bin": {
    "dkbezeler": "cli/index.mjs"
  },
  "files": [
    "cli",
    "data",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "bezel",
    "device-frame",
    "mockup",
    "screenshot",
    "screen-recording",
    "iphone",
    "app-store",
    "marketing",
    "sharp",
    "shadcn",
    "shadcn-registry"
  ],
  "dependencies": {
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "react": "^19.2.7",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diklein/dkbezeler.git"
  },
  "bugs": {
    "url": "https://github.com/diklein/dkbezeler/issues"
  }
}
